<odoo>
    <record id="view_customer_tree" model="ir.ui.view">
        <field name="name">sales.customer.tree</field>
        <field name="model">sales.customer</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
            </tree>
        </field>
    </record>

    <record id="view_customer_form" model="ir.ui.view">
        <field name="name">sales.customer.form</field>
        <field name="model">sales.customer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="phone"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_customer_search" model="ir.ui.view">
        <field name="name">sales.customer.search</field>
        <field name="model">sales.customer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
            </search>
        </field>
    </record>

    <record id="action_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">sales.customer</field>
        <field name="view_mode">tree,form,search</field>
    </record>

    <record id="view_product_tree" model="ir.ui.view">
        <field name="name">sales.product.tree</field>
        <field name="model">sales.product</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="price"/>
                <field name="quantity_in_stock"/>
            </tree>
        </field>
    </record>

    <record id="view_product_form" model="ir.ui.view">
        <field name="name">sales.product.form</field>
        <field name="model">sales.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="price"/>
                        <field name="quantity_in_stock"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_search" model="ir.ui.view">
        <field name="name">sales.product.search</field>
        <field name="model">sales.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="low_stock" string="Low Stock" domain="[('quantity_in_stock', '&lt;', 5)]"/>
            </search>
        </field>
    </record>

    <record id="action_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">sales.product</field>
        <field name="view_mode">tree,form,search</field>
    </record>

    <record id="view_order_tree" model="ir.ui.view">
        <field name="name">sales.order.tree</field>
        <field name="model">sales.order</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-success="state == 'confirmed'">
                <field name="order_date"/>
                <field name="customer_id"/>
                <field name="total_price" sum="Total Amount"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sales.order.form</field>
        <field name="model">sales.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm Order" type="object" states="draft" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="customer_id"/>
                        <field name="order_date"/>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_price" widget="monetary"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_order_search" model="ir.ui.view">
        <field name="name">sales.order.search</field>
        <field name="model">sales.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_id"/>
                <filter name="draft" string="Draft Orders" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed Orders" domain="[('state', '=', 'confirmed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_order" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">sales.order</field>
        <field name="view_mode">tree,form,search</field>
    </record>

    <menuitem id="menu_sales_root" name="Sales System" web_icon="sales_system,static/description/icon.png"/>
    <menuitem id="menu_customer" name="Customers" parent="menu_sales_root" action="action_customer" sequence="10"/>
    <menuitem id="menu_product" name="Products" parent="menu_sales_root" action="action_product" sequence="20"/>
    <menuitem id="menu_order" name="Orders" parent="menu_sales_root" action="action_order" sequence="30"/>
</odoo>
